function [Ff, ff] = get_term_state_constraints(LTI, con ,dim)
%UNTITLED3 Summary of this function goes here
%   Detailed explanation goes here
%   Terminal State Constraint : assume the same as state to be ok
LTI.K = -LTI.K;
LTI.Aclosed = LTI.A + LTI.B*LTI.K;

LTI.furutaClosed = LTISystem('A', LTI.Aclosed);
eig(LTI.Aclosed)
LTI.furutaClosed = LTISystem('A', LTI.Aclosed);

LTI.furutaClosed.x.min = con.xmin; 
LTI.furutaClosed.x.max = con.xmax;

con.invariant_set = LTI.furutaClosed.invariantSet();

disp(['Terminal state done. Empty : ', num2str(con.invariant_set.isEmptySet())])
% tol1 = 0.2; tol2 = 0.2; tol3 = 1;
% con.Ff = con.F;
% con.ff = [tol1; tol1; tol2; tol2; tol3; tol3; tol3; tol3; tol3; tol3];

Ff = con.invariant_set.A; ff = con.invariant_set.b;
con.F = [eye(dim.nx); -eye(dim.nx)];
con.f = [con.xmax;  -con.xmin];
con.terminal_set = Polyhedron(con.F,con.f);

% terminal set to include the control action bound
Fu = [LTI.K; -LTI.K]; 
fu = [con.umax; -con.umin];

con.terminal_Set = con.terminal_set.intersect(Polyhedron(Fu, fu));

if con.terminal_Set.contains(LTI.x0)
    disp('The initial conditions are in the terminal set')
else
    disp('The initial conditions are not in the terminal set');
end

if con.invariant_set.contains(LTI.x0)
    disp('The initial conditions are in the invariant set')
else
    disp('The initial conditions are not in the invariant set');
end

if con.terminal_set.contains(con.invariant_set)
    disp('P is fully contained in Q.');
else
    disp('P is NOT fully contained in Q.');
end
end
